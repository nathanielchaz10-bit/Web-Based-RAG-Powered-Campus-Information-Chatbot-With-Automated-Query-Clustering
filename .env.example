# =============================================================================
# Copy this file to ".env" and fill in real values. The .env file is gitignored.
#
# NOTE: The FastAPI app (hccs_rag_chatbot/main.py) currently boots without these
# because main.py does not yet import app.core.config. But anything that touches
# the DB layer (database/seed.py, verify_db.py, the SQLAlchemy models, and the
# upcoming RAG/clustering endpoints) imports app.core.config, which instantiates
# Settings() and REQUIRES every non-default field below. Fill them in before
# running those, or you'll hit pydantic "field required" errors on startup.
# =============================================================================

# --- Gemini / LLM ------------------------------------------------------------
GEMINI_API_KEY=your_api_key_here   # use the free tier for now, or ask for one
EMBEDDING_MODEL=gemini-embedding-001   # matches src/ engines
LLM_MODEL=gemini-2.5-flash             # matches src/ engines

# --- Google OAuth (their auth layer) -----------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback
HCCS_DOMAIN=hccs.edu.ph   # school domain to restrict logins to (verify exact value)

# --- Databases ---------------------------------------------------------------
# Paths are relative to wherever you launch the app. The values below assume you
# run from inside hccs_rag_chatbot/. Adjust if you run from the repo root.
SQLITE_DB_PATH=database/hccs_rag.db
# Folder for the ChromaDB vector index. It is created/populated on first run by
# embedding the files in docs/. Leave this commented out to use the default
# (<repo root>/chroma_db). Do NOT point it at a folder that already contains
# non-index files, or the engine will treat it as a pre-built (but empty) store.
CHROMA_DB_PATH=chroma_db

# --- Security / JWT ----------------------------------------------------------
JWT_SECRET_KEY=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- RAG configuration (defaults mirror src/rag_engine.py where known) -------
TOP_K_CHUNKS=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RELEVANCE_THRESHOLD=0.7    # not yet used by src/ engine; placeholder
RAG_TEMPERATURE=0
MAX_CONTEXT_TOKENS=4000    # not yet used by src/ engine; placeholder

# --- Rate limiting -----------------------------------------------------------
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# --- Clustering (agglomerative) ----------------------------------------------
CLUSTERING_MIN_QUERIES=3      # min total valid queries before a run will start
CLUSTERING_MIN_CLUSTER_SIZE=3 # min members for a group to survive as a cluster
CLUSTERING_SCHEDULE_HOUR=2    # hour of day to run scheduled clustering

# Cosine DISTANCE (1 - similarity) at which clusters stop merging. Lower =
# more/tighter clusters, higher = fewer/broader (too high merges everything
# into one cluster). Gemini embeddings are anisotropic, so a smallish value is
# needed. Run `python tune_threshold.py` to find the best value for your data.
CLUSTERING_DISTANCE_THRESHOLD=0.25

# --- Dev mode ----------------------------------------------------------------
# True during development/demo; set False in production to enforce HCCS_DOMAIN.
DEV_MODE=True

# --- LangSmith tracing (optional, for capstone testing) ----------------------
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT="Capstone_RAG_Testing"

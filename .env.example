# =============================================================================
# Copy this file to ".env" and fill in real values. The .env file is gitignored.
#
# NOTE: The FastAPI app (hccs_rag_chatbot/main.py) currently boots without these
# because main.py does not yet import app.core.config. But anything that touches
# the DB layer (database/seed.py, verify_db.py, the SQLAlchemy models, and the
# upcoming RAG/clustering endpoints) imports app.core.config, which instantiates
# Settings() and REQUIRES every non-default field below. Fill them in before
# running those, or you'll hit pydantic "field required" errors on startup.
# =============================================================================

# --- Gemini / LLM ------------------------------------------------------------
GEMINI_API_KEY=your_api_key_here   # use the free tier for now, or ask for one
EMBEDDING_MODEL=gemini-embedding-001   # matches src/ engines
LLM_MODEL=gemini-2.5-flash             # matches src/ engines

# --- Google OAuth (their auth layer) -----------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Must match an "Authorized redirect URI" in the Google Cloud console EXACTLY.
# Local dev: http://localhost:8000/api/auth/callback
# Deployment (behind the tunnel): https://<your-tunnel-host>/api/auth/callback
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/callback
HCCS_DOMAIN=hccs.edu.ph   # school domain to restrict logins to (verify exact value)

# --- Databases ---------------------------------------------------------------
# Paths are relative to wherever you launch the app. The values below assume you
# run from inside hccs_rag_chatbot/. Adjust if you run from the repo root.
SQLITE_DB_PATH=database/hccs_rag.db
# Folder for the ChromaDB vector index. It is created/populated on first run by
# embedding the files in docs/. Leave this commented out to use the default
# (<repo root>/chroma_db). Do NOT point it at a folder that already contains
# non-index files, or the engine will treat it as a pre-built (but empty) store.
CHROMA_DB_PATH=chroma_db

# --- Security / JWT ----------------------------------------------------------
# REQUIRED for deployment: a long random secret. With the default value anyone
# can forge a Bearer token claiming role=Head Admin. The app REFUSES TO START
# when DEV_MODE=False and this is left at the default. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- CORS --------------------------------------------------------------------
# Comma-separated allowed browser origins. The frontend is served same-origin by
# this app, so CORS is largely moot; "*" is fine for dev. In deployment you may
# lock it to your tunnel URL, e.g. CORS_ALLOW_ORIGINS=https://<your-tunnel-host>
CORS_ALLOW_ORIGINS=*

# --- RAG configuration (defaults mirror src/rag_engine.py where known) -------
TOP_K_CHUNKS=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RELEVANCE_THRESHOLD=0.7    # not yet used by src/ engine; placeholder
RAG_TEMPERATURE=0
MAX_CONTEXT_TOKENS=4000    # not yet used by src/ engine; placeholder

# --- Rate limiting -----------------------------------------------------------
# Per-minute burst guards (abuse / quota spikes).
# Per-user "front door": max queries one user may submit per window (abuse guard).
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
# Global "back door": max chat turns the whole server admits per window, across
# all users, protecting the shared Gemini quota. ~= Gemini Flash RPM / 2 (each
# turn ~2 Flash calls). Lower on the free tier; set <=0 to disable.
RATE_LIMIT_GLOBAL_MAX_REQUESTS=30
RATE_LIMIT_GLOBAL_WINDOW_SECONDS=60

# Daily budget caps (the REAL protector for a small fixed-dollar Gemini key).
# Counted from the database so they survive restarts. The per-minute limits
# above only cap bursts; only a daily ceiling caps cumulative spend over days.
# Per-student questions/day (fair-use spread). 0 = unlimited.
RATE_LIMIT_USER_DAILY_MAX=20
# Server-wide questions/day — size so (this * days you run) stays under your
# Gemini credit. ~$0.003-0.005/turn => ~$10 ≈ 300-450/day over a 7-day run.
# 0 = unlimited. Google billing is the hard backstop.
RATE_LIMIT_GLOBAL_DAILY_MAX=300
# Manual kill switch. False pauses the chatbot for everyone instantly (also
# toggleable live in Portal Settings, no restart needed).
CHAT_ENABLED=True

# --- Clustering (agglomerative) ----------------------------------------------
CLUSTERING_MIN_QUERIES=3      # min total valid queries before a run will start
CLUSTERING_MIN_CLUSTER_SIZE=3 # min members for a group to survive as a cluster
CLUSTERING_SCHEDULE_HOUR=2    # hour of day to run scheduled clustering

# Cosine DISTANCE (on mean-centered embeddings) at which clusters stop merging.
# Lower = more/tighter clusters, higher = fewer/broader. 0.85 was tuned on real
# cached vectors (8 balanced topics, ~82% coverage). Run `python
# scripts/tune_threshold.py` to re-tune against your own data.
CLUSTERING_DISTANCE_THRESHOLD=0.85

# --- Dev mode ----------------------------------------------------------------
# CRITICAL. While True: a request with NO/invalid token is treated as HEAD
# ADMIN, /api/auth/dev-login mints admin tokens with no password, and the
# @HCCS_DOMAIN sign-in restriction is relaxed. That is fine locally but
# CATASTROPHIC behind a public link. Set False before sharing the tunnel URL.
# (The app prints a loud warning on startup whenever this is True.)
DEV_MODE=False

# --- LangSmith tracing (optional, for capstone testing) ----------------------
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT="Capstone_RAG_Testing"
